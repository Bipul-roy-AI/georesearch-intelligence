        0
      ],
      "parameters": {
        "url": "https://api.crossref.org/works?query.bibliographic=geospatial+public+health&filter=type%3Ajournal-article&rows=100&select=DOI%2Ctitle%2Cauthor%2Ccontainer-title%2Cpublished%2Cissued%2CISSN%2CURL%2Ctype",
        "options": {}
      }
    },
    {
      "id": "field-atlas-format",
      "name": "Format journal records",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "function convert(rows) {\n    const lines=[];\n    const field=(tag,v)=>{if(v)lines.push(tag+'  - '+String(v).replace(/[\\r\\n]+/g,' ').trim());};\n    const seen=new Set();\n    for(const row of rows){\n      if(!row.title?.[0]||row.type!=='journal-article'||seen.has(row.DOI))continue;\n      seen.add(row.DOI);field('TY','JOUR');field('TI',row.title[0]);field('JO',row['container-title']?.[0]);\n      for(const person of row.author||[])field('AU',person.name||[person.family,person.given].filter(Boolean).join(', '));\n      field('PY',(row.published||row.issued)?.['date-parts']?.[0]?.[0]);field('DO',row.DOI);field('UR',row.URL);\n      for(const serial of row.ISSN||[])field('SN',serial);\n      lines.push('ER  - ','');\n    }\n    return lines.join('\\r\\n');\n  }\nreturn [{json:{ris:convert($input.first().json.message.items)}}];"
      }
    },
    {
      "id": "field-atlas-export",
      "name": "Download RIS",
